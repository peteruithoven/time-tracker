using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Timer");

    Adw.ShortcutsItem {
      title: _("Start or Stop the Timer");
      action-name: "win.toggle-timer";
    }

    Adw.ShortcutsItem {
      title: _("Choose a Task");
      action-name: "win.choose-task";
    }

    Adw.ShortcutsItem {
      title: _("Add Time");
      action-name: "win.add-time";
    }
  }

  Adw.ShortcutsSection {
    title: _("Views");

    Adw.ShortcutsItem {
      title: _("Track");
      action-name: "win.view-track";
    }

    Adw.ShortcutsItem {
      title: _("Review");
      action-name: "win.view-review";
    }

    Adw.ShortcutsItem {
      title: _("Previous Month");
      action-name: "win.previous-month";
    }

    Adw.ShortcutsItem {
      title: _("Next Month");
      action-name: "win.next-month";
    }

    Adw.ShortcutsItem {
      title: _("Export Month");
      action-name: "win.export";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Clients & Projects");
      action-name: "app.clients";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }
}
