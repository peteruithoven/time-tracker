using Gtk 4.0;
using Adw 1;

template $TaskPicker: Popover {
  child: Stack stack {
    vhomogeneous: false;
    transition-type: slide_left_right;

    StackPage {
      name: "list";

      child: Box {
        orientation: vertical;
        spacing: 6;
        width-request: 320;

        SearchEntry search_entry {
          placeholder-text: _("Search tasks");
        }

        ScrolledWindow {
          vscrollbar-policy: never;

          child: Box client_filter {
            spacing: 6;
            margin-top: 2;
            margin-bottom: 2;
          };
        }

        ScrolledWindow {
          hscrollbar-policy: never;
          propagate-natural-height: true;
          max-content-height: 380;

          child: ListBox task_list {
            selection-mode: browse;

            styles [
              "navigation-sidebar",
            ]
          };
        }

        Label no_results {
          label: _("No matching tasks");
          margin-top: 12;
          margin-bottom: 12;
          visible: false;

          styles [
            "dim-label",
          ]
        }

        Separator {}

        Button create_button {
          child: Box {
            spacing: 8;

            Image {
              icon-name: "list-add-symbolic";
            }

            Label create_label {
              hexpand: true;
              xalign: 0;
              ellipsize: end;
              label: _("New Task…");
            }

            Label {
              label: _("Ctrl+Enter");

              styles [
                "caption",
                "dim-label",
              ]
            }
          };

          styles [
            "flat",
            "accent",
          ]
        }
      };
    }

    StackPage {
      name: "create";

      child: Box {
        orientation: vertical;
        spacing: 12;
        width-request: 320;
        margin-top: 6;
        margin-bottom: 6;
        margin-start: 6;
        margin-end: 6;

        Label {
          xalign: 0;
          label: _("New Task");

          styles [
            "heading",
          ]
        }

        ListBox {
          selection-mode: none;

          Adw.EntryRow name_row {
            title: _("Name");
          }

          Adw.ActionRow project_row {
            title: _("Project");
            activatable-widget: project_button;

            [suffix]
            MenuButton project_button {
              valign: center;
              popover: $ProjectPicker project_picker {};

              child: Box {
                spacing: 6;

                Label project_label {
                  ellipsize: end;
                  max-width-chars: 18;
                }

                Image {
                  icon-name: "pan-down-symbolic";
                }
              };

              styles [
                "flat",
              ]
            }
          }

          styles [
            "boxed-list",
          ]
        }

        CheckButton start_check {
          label: _("Start timer on this task");
          active: true;
        }

        Box {
          halign: end;
          spacing: 8;

          Button cancel_button {
            label: _("Cancel");
          }

          Button confirm_button {
            label: _("Create");
            sensitive: false;

            styles [
              "suggested-action",
            ]
          }
        }
      };
    }
  };

  styles [
    "task-picker",
  ]
}
