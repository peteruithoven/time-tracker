using Gtk 4.0;
using Adw 1;

template $TimeTrackerWindow: Adw.ApplicationWindow {
  title: _("Time Tracker");
  width-request: 360;
  height-request: 400;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.ToggleGroup view_toggle {
        Adw.Toggle {
          name: "track";
          label: _("Track");
        }

        Adw.Toggle {
          name: "review";
          label: _("Review");
        }
      };

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }

      [end]
      MenuButton sync_button {
        visible: false;
        tooltip-text: _("Sync Status");

        child: Overlay {
          Image sync_icon {
            icon-name: "emblem-synchronizing-symbolic";
          }

          [overlay]
          Box sync_dot {
            visible: false;
            halign: end;
            valign: start;

            styles [
              "sync-dot",
            ]
          }
        };

        popover: Popover sync_popover {
          child: Box {
            orientation: vertical;
            spacing: 6;
            width-request: 300;
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;

            Label sync_title {
              xalign: 0;
              wrap: true;

              styles [
                "heading",
              ]
            }

            Label sync_detail {
              xalign: 0;
              wrap: true;
              max-width-chars: 40;

              styles [
                "dim-label",
              ]
            }

            ListBox sync_list {
              selection-mode: none;
              margin-top: 6;

              styles [
                "boxed-list",
              ]
            }

            Box {
              spacing: 12;
              margin-top: 6;

              Label sync_last {
                xalign: 0;
                hexpand: true;
                wrap: true;

                styles [
                  "dim-label",
                  "caption",
                ]
              }

              Button sync_now_button {
                label: _("Sync Now");
                valign: center;
              }
            }
          };
        };
      }
    }

    // Design O: a pull from Fibery is held for review.
    [top]
    Adw.Banner sync_banner {
      button-label: _("Review");
    }

    content: Adw.ViewStack view_stack {
      Adw.ViewStackPage {
        name: "track";
        title: _("Track");

        child: $TrackPage track_page {};
      }

      Adw.ViewStackPage {
        name: "review";
        title: _("Review");

        child: $ReviewPage review_page {};
      }
    };
  };

  // Below this width the Review table only shows the total column.
  Adw.Breakpoint {
    condition ("max-width: 620sp")

    setters {
      review_page.compact: true;
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Clients & Projects");
      action: "app.clients";
    }

    item {
      label: _("_Export Month…");
      action: "win.export";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Time Tracker");
      action: "app.about";
    }
  }
}
