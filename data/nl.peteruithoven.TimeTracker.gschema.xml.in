<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@gettext-package@">
  <schema path="/nl/peteruithoven/TimeTracker/" id="@app-id@">
    <key name="window-width" type="i">
      <default>360</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>560</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="last-view" type="s">
      <choices>
        <choice value="track"/>
        <choice value="review"/>
      </choices>
      <default>'track'</default>
      <summary>Last visible view</summary>
    </key>
    <key name="idle-detection" type="b">
      <default>true</default>
      <summary>Ask about away time</summary>
      <description>When you come back after being away while the timer runs, ask what to do with that time.</description>
    </key>
    <key name="idle-minutes" type="i">
      <range min="1" max="240"/>
      <default>10</default>
      <summary>Minutes without input before you count as away</summary>
    </key>
  </schema>
</schemalist>
